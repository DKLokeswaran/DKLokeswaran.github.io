---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const headingId = `project-${project.id}`;
---

<article class="project" aria-labelledby={headingId}>
  <div class="project-kicker">
    <h3 id={headingId}>{project.data.title}</h3>
    {project.data.featured ? <p class="flag">Featured</p> : null}
  </div>
  <p class="summary">{project.data.summary}</p>
  <div class="project-body">
    <Content />
  </div>
  {
    project.data.status ? (
      <p class="status">
        <span class="status-label">Status</span>
        {project.data.status}
      </p>
    ) : null
  }
  <h4>Stack</h4>
  <ul class="stack">
    {project.data.stack.map((item) => <li>{item}</li>)}
  </ul>
  <p class="project-link">
    <a href={project.data.url}>GitHub repository</a>
  </p>
</article>
